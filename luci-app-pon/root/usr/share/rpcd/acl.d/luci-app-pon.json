{
	"luci-app-pon": {
		"description": "Grant access to PON configuration and board data",
		"read": {
			"cgi-io": [ "exec" ],
			"uci": [ "pon", "airoha-pon-debug" ],
			"ubus": {
				"file": [ "read" ]
			},
			"file": {
				"/usr/sbin/ponctl --device * status": [ "exec" ],
				"/usr/sbin/ponctl --device * status --json": [ "exec" ],
				"/usr/sbin/ponctl version --json": [ "exec" ],
				"/bin/busybox wget -q -O - *": [ "exec" ],
				"/usr/bin/sha256sum /tmp/luci-app-pon-online.apk": [ "exec" ],
				"/usr/bin/pondctl status --line *": [ "exec" ],
				"/usr/libexec/pon-board-identity list": [ "exec" ],
				"/usr/libexec/pon-board-identity read *": [ "exec" ],
				"/usr/libexec/airoha-pon-data list": [ "exec" ],
				"/sbin/uci export pon": [ "exec" ],
				"/tmp/pon-debug.tar.gz": [ "read" ],
				"/tmp/pon-config-backup": [ "read" ],
				"/tmp/pon-config-import": [ "read" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"uci": [ "pon", "airoha-pon-debug" ],
			"ubus": {
				"file": [ "exec", "write" ]
			},
			"file": {
				"/tmp/pon-board-data.bin": [ "write" ],
				"/tmp/pon-config-backup": [ "write" ],
				"/tmp/pon-config-import": [ "write" ],
				"/tmp/luci-app-pon-update.apk": [ "write" ],
				"/tmp/luci-app-pon-online.apk": [ "write" ],
				"/bin/busybox wget -q -O /tmp/luci-app-pon-online.apk *": [ "exec" ],
				"/usr/bin/apk add --allow-untrusted /tmp/luci-app-pon-online.apk": [ "exec" ],
				"/usr/bin/apk add --allow-untrusted /tmp/luci-app-pon-update.apk": [ "exec" ],
				"/usr/libexec/airoha-pon-data write *": [ "exec" ],
				"/usr/libexec/pon-board-identity write *": [ "exec" ],
				"/usr/libexec/airoha-pon-debug collect": [ "exec" ],
				"/usr/libexec/airoha-pon-debug restart": [ "exec" ],
				"/sbin/uci import pon *": [ "exec" ],
				"/etc/init.d/pon restart": [ "exec" ]
			}
		}
	}
}
